+++ b/tests/features/ocr/init_spec.lua
@@ -0,0 +1,44 @@
+--[[-- features.ocr：扫描页选区先 OCR 再弹划词菜单；识别不出来提示并不弹。 --]]
+
+local Assert = require("support.assert")
+
+local prompts = 0
+package.preload["features.ocr.ui"] = function()
+    return { promptMissing = function() prompts = prompts + 1 end }
+end
+local Ocr = require("features.ocr")
+
+-- 有文字层：不动。
+local hl = { selected_text = { text = "已有" } }
+Assert.is_true(Ocr.fillSelection(hl))
+Assert.eq(hl.selected_text.text, "已有")
+
+-- 扫描页：getOCRText 的结果写回 selected_text.text，菜单按钮都能拿到。
+local doc = { getOCRText = function(_, page, boxes) return page == 3 and #boxes == 2 and "识别文字" or nil end }
+hl = { ui = { document = doc }, hold_pos = { page = 3 }, selected_text = { text = "", sboxes = { {}, {} } } }
+Assert.is_true(Ocr.fillSelection(hl))
+Assert.eq(hl.selected_text.text, "识别文字")
+
+-- getOCRText 为空：退回逐词 getOCRWord。
+doc = {
+    getOCRText = function() return "" end,
+    getOCRWord = function(_, _page, w) return w.sbox.word end,
+}
+hl = { ui = { document = doc }, hold_pos = { page = 1 }, selected_text = { text = "", sboxes = { { word = "ab" }, { word = "cd" } } } }
+Assert.is_true(Ocr.fillSelection(hl))
+Assert.eq(hl.selected_text.text, "abcd")
+
+-- 识别不出来：提示、清选区、不弹菜单。
+local cleared = false
+doc = { getOCRText = function() return nil end }
+hl = { ui = { document = doc }, hold_pos = { page = 1 }, selected_text = { text = "", sboxes = { {} } },
+    clear = function() cleared = true end }
+Assert.is_false(Ocr.fillSelection(hl))
+Assert.eq(prompts, 1)
+Assert.is_true(cleared)
+
+-- 重排文档（没有 getOCRText）：原样放行。
+hl = { ui = { document = {} }, hold_pos = { page = 1 }, selected_text = { text = "", sboxes = { {} } } }
+Assert.is_true(Ocr.fillSelection(hl))
+
+return true
diff --git a/tests/features/ocr/manager_spec.lua b/tests/features/ocr/manager_spec.lua
new file mode 100644
index 00000000..9e030208
--- /dev/null
+++ b/tests/features/ocr/manager_spec.lua
@@ -0,0 +1,167 @@
+--[[-- features.ocr.manager：清单校验、下载校验原子安装、只删自己装且未被替换的模型、语言列表原地刷新。 --]]
+
+local Assert = require("support.assert")
+
+-- 没有 KOReader 源码时退回系统 sha256 命令。
+if not pcall(require, "ffi/sha2") then
+    package.preload["ffi/sha2"] = function()
+        return { sha256 = function()
+            local chunks = {}
+            return function(data)
+                if data then chunks[#chunks + 1] = data; return end
+                local tmp = os.tmpname()
+                local f = assert(io.open(tmp, "wb")); f:write(table.concat(chunks)); f:close()
+                local p = io.popen("(sha256sum " .. tmp .. " || shasum -a 256 " .. tmp .. ") 2>/dev/null")
+                local out = p:read("*l"); p:close(); os.remove(tmp)
+                return out:match("^(%x+)")
+            end
+        end }
+    end
+end
+local sha256 = function(text)
+    local h = require("ffi/sha2").sha256(); h(text); return h()
+end
+
+local store = {}
+package.preload["json"] = function()
+    return {
+        decode = function(s) return store[s] or error("bad json") end,
+        encode = function(t) local key = "json#" .. tostring(t); store[key] = t; return key end,
+    }
+end
+local downloads = {}
+package.preload["http.request"] = function()
+    return { download = function(opts, dest, cb)
+        downloads[#downloads + 1] = { opts = opts, dest = dest, cb = cb }
+        return { cancel = function() end }
+    end }
+end
+package.preload["workers.job"] = function()
+    return { run = function(fn, opts)
+        local ok, err = pcall(fn)
+        if ok then opts.on_done() else opts.on_failed(err) end
+    end }
+end
+package.preload["util"] = function()
+    return { makePath = function(p) os.execute("mkdir -p '" .. p .. "'"); return true end }
+end
+
+local Manager = require("features.ocr.manager")
+
+-- 清单校验：id 只放行 [%w_]，file 必须是 <id>.traineddata，sha256 64 位。
+local hash = string.rep("a", 64)
+local good = { id = "chi_sim", name = "简体中文", file = "chi_sim.traineddata", size = 5, sha256 = hash }
+Assert.len(assert(Manager.validateManifest({ models = { good } })), 1)
+local function bad(patch)
+    local item = {}
+    for k, v in pairs(good) do item[k] = v end
+    for k, v in pairs(patch) do item[k] = v end
+    return Manager.validateManifest({ models = { item } })
+end
+Assert.is_nil(bad({ id = "../x", file = "../x.traineddata" }), "路径穿越")
+Assert.is_nil(bad({ file = "other.traineddata" }), "文件名必须对应 id")
+Assert.is_nil(bad({ sha256 = "xyz" }))
+Assert.is_nil(bad({ size = 0 }))
+Assert.is_nil(Manager.validateManifest({ models = { good, good } }), "重复 id")
+Assert.is_nil(Manager.validateManifest({ models = {} }))
+
+-- 安装：下载到 .part → 校验 → 原子改名 → 记所有权 → 加入 Document Language。
+local dir = os.tmpname()
+os.remove(dir)
+os.execute("mkdir -p '" .. dir .. "'")
+local option = { name = "doc_language", values = { "eng" }, toggle = { "English" } }
+option.args = option.values
+package.loaded["ui/data/koptoptions"] = { { options = { option } } }
+package.loaded["ui/data/isolanguage"] = { getLocalizedLanguage = function(_, code) return "L:" .. code end }
+
+local body = "model"
+local item = { id = "chi_sim", name = "简体中文", file = "chi_sim.traineddata", size = #body, sha256 = sha256(body) }
+local result
+Manager.install(item, dir, function(ok, err) result = { ok = ok, err = err } end)
+Assert.len(downloads, 1)
+Assert.eq(downloads[1].dest, dir .. "/chi_sim.traineddata.part")
+Assert.eq(downloads[1].opts.url, Manager.BASE_URL .. "/chi_sim.traineddata")
+local f = assert(io.open(downloads[1].dest, "wb")); f:write(body); f:close()
+downloads[1].cb(true)
+Assert.is_true(result.ok)
+Assert.is_true(Manager.isInstalled(dir, "chi_sim"))
+Assert.is_nil(io.open(dir .. "/chi_sim.traineddata.part", "rb"), ".part 已改名")
+Assert.is_true(Manager.isOwned(dir, "chi_sim"))
+Assert.eq(table.concat(option.values, ","), "eng,chi_sim", "原地追加，不用重启")
+Assert.eq(option.toggle[2], "L:chi_sim")
+
+-- 校验失败：不落地，.part 删除。
+local tampered = { id = "jpn", name = "日语", file = "jpn.traineddata", size = 5, sha256 = hash }
+Manager.install(tampered, dir, function(ok, err) result = { ok = ok, err = err } end)
+f = assert(io.open(downloads[2].dest, "wb")); f:write("bogus"); f:close()
+downloads[2].cb(true)
+Assert.is_false(result.ok)
+Assert.is_false(Manager.isInstalled(dir, "jpn"))
+Assert.is_nil(io.open(dir .. "/jpn.traineddata.part", "rb"))
+
+-- 下载失败：清掉半截 .part。
+Manager.install(tampered, dir, function(ok, err) result = { ok = ok, err = err } end)
+f = assert(io.open(downloads[3].dest, "wb")); f:write("half"); f:close()
+downloads[3].cb(false, "timeout")
+Assert.eq(result.err, "timeout")
+Assert.is_nil(io.open(dir .. "/jpn.traineddata.part", "rb"))
+
+-- 用户自装的模型：列出但拒绝删除。
+f = assert(io.open(dir .. "/eng.traineddata", "wb")); f:write("user"); f:close()
+Assert.eq(table.concat(Manager.installed(dir), ","), "chi_sim,eng")
+local ok, err = Manager.remove(dir, "eng")
+Assert.is_false(ok)
+Assert.eq(err, "not installed by this plugin")
+Assert.is_true(Manager.isInstalled(dir, "eng"))
+
+-- 自己装的但文件被替换（sha 不一致）：同样拒绝。
+f = assert(io.open(dir .. "/chi_sim.traineddata", "wb")); f:write("replaced"); f:close()
+Assert.is_false((Manager.remove(dir, "chi_sim")))
+Assert.is_true(Manager.isInstalled(dir, "chi_sim"))
+
+-- 恢复原文件后可删；所有权与语言列表同步移除。
+f = assert(io.open(dir .. "/chi_sim.traineddata", "wb")); f:write(body); f:close()
+Assert.is_true((Manager.remove(dir, "chi_sim")))
+Assert.is_false(Manager.isInstalled(dir, "chi_sim"))
+Assert.is_nil(Manager.owned(dir).chi_sim)
+Assert.eq(table.concat(option.values, ","), "eng")
+Assert.len(option.toggle, 1)
+Assert.is_false((Manager.remove(dir, "../etc")))
+
+-- 默认识别语言写 KOReader kopt 默认值；当前扫描书立即切换。
+local saved = {}
+local old_g = _G.G_reader_settings
+_G.G_reader_settings = {
+    readSetting = function(_, k) return saved[k] end,
+    saveSetting = function(_, k, v) saved[k] = v end,
+}
+Manager.setDefaultLanguage("chi_tra")
+Assert.eq(Manager.defaultLanguage(), "chi_tra")
+Assert.eq(saved.kopt_doc_language, "chi_tra")
+local events = {}
+package.loaded["ui/event"] = { new = function(_, name, arg) return { name = name, arg = arg } end }
+package.loaded["apps/reader/readerui"] = { instance = {
+    document = { configurable = { doc_language = "eng" }, koptinterface = {} },
+    handleEvent = function(_, ev) events[#events + 1] = ev end,
+} }
+-- Forced OCR：开着扫描书读这本书的值；写入同时改全局默认与当前书。
+Assert.is_false(Manager.forcedOcr())
+Manager.setForcedOcr(true)
+Assert.eq(saved.kopt_forced_ocr, 1)
+Assert.eq(package.loaded["apps/reader/readerui"].instance.document.configurable.forced_ocr, 1)
+Assert.is_true(Manager.forcedOcr())
+Manager.setForcedOcr(false)
+Assert.eq(saved.kopt_forced_ocr, 0)
+Assert.is_true(Manager.applyToOpenDocument("chi_sim"))
+Assert.eq(Manager.currentLanguage(), "chi_sim")
+Assert.eq(events[1].name, "DocLangUpdate")
+package.loaded["apps/reader/readerui"] = { instance = { document = { configurable = {} } } }
+Assert.is_false(Manager.applyToOpenDocument("chi_sim"), "重排文档不切")
+package.loaded["apps/reader/readerui"] = { instance = nil }
+saved.kopt_forced_ocr = 1
+Assert.is_true(Manager.forcedOcr(), "没开书读全局默认")
+package.loaded["apps/reader/readerui"] = nil
+_G.G_reader_settings = old_g
+
+os.execute("rm -rf '" .. dir .. "'")
+return true
diff --git a/tests/features/ocr/setting_spec.lua b/tests/features/ocr/setting_spec.lua
new file mode 100644
index 00000000..74ea0c9b
--- /dev/null
+++ b/tests/features/ocr/setting_spec.lua
@@ -0,0 +1,47 @@
+--[[-- features.ocr.setting：「划词与查询」页词典之后追加「文字识别（OCR）」分节。 --]]
+
+local Assert = require("support.assert")
+
+package.preload["gettext"] = function() return function(text) return text end end
+package.preload["ui.themes.widgets.row"] = function() return { widget = function(opts) return opts end } end
+local installed = {}
+local forced = false
+package.preload["features.ocr.manager"] = function()
+    return {
+        dataDir = function() return "/tess" end,
+        installed = function() return installed end,
+        forcedOcr = function() return forced end,
+        setForcedOcr = function(on) forced = on end,
+    }
+end
+local calls = {}
+package.preload["features.ocr.ui"] = function()
+    return {
+        download = function() calls[#calls + 1] = "download" end,
+        manage = function() calls[#calls + 1] = "manage" end,
+    }
+end
+
+local updates = 0
+local entry = require("features.ocr.setting").entries({ updateView = function() updates = updates + 1 end })[1]
+Assert.eq(entry.parent, "lookup")
+Assert.is_true(entry.order > 50, "排在词典（50）之后")
+local section = entry.sections()[1]
+Assert.eq(section.title, "文字识别（OCR）")
+-- 第一行：KOReader「Forced OCR」开关，读写同一设置并刷新页面。
+Assert.eq(section.rows[1](600).title, "强制文字识别")
+Assert.is_false(section.rows[1](600).status_on)
+section.rows[1](600).callback()
+Assert.is_true(forced)
+Assert.eq(updates, 1)
+Assert.is_true(entry.sections()[1].rows[1](600).status_on)
+Assert.eq(section.rows[2](600).title, "下载识别语言")
+Assert.eq(section.rows[2](600).subtitle, "仅对扫描版 PDF / DjVu 生效，长按文字即可识别")
+Assert.eq(section.rows[3](600).status, "未安装")
+section.rows[2](600).callback()
+section.rows[3](600).callback()
+Assert.eq(table.concat(calls, ","), "download,manage")
+installed = { "chi_sim", "eng" }
+Assert.eq(entry.sections()[1].rows[3](600).status, "2")
+
+return true
diff --git a/tools/build_ocr_manifest.py b/tools/build_ocr_manifest.py
new file mode 100644
index 00000000..5a426dfc
--- /dev/null
+++ b/tools/build_ocr_manifest.py
@@ -0,0 +1,94 @@
+#!/usr/bin/env python3
+"""下载 Tesseract tessdata_fast 识别模型并生成 assets/ocr/manifest.json。
+
+用法：python3 tools/build_ocr_manifest.py [--fetch] [--out-dir assets/ocr]
+
+不带 --fetch 时只为已有的 <id>.traineddata 重算 size / sha256；带 --fetch 先从上游
+（raw.githubusercontent.com，失败回退 jsDelivr）下载。模型为 LSTM fast 版，兼容
+KOReader 内置的 Tesseract 4.x / 5.x。只依赖 Python 标准库。
+
+数据来源：https://github.com/tesseract-ocr/tessdata_fast （Apache-2.0）
+"""
+
+import argparse
+import hashlib
+import json
+import os
+import urllib.request
+
+SOURCES = [
+    "https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/main/{id}.traineddata",
+    "https://cdn.jsdelivr.net/gh/tesseract-ocr/tessdata_fast@main/{id}.traineddata",
+]
+
+# id 是 Tesseract 语言码（即 traineddata 文件名），name 是下载页显示名。
+MODELS = [
+    {"id": "chi_sim", "name": "简体中文"},
+    {"id": "chi_tra", "name": "繁体中文"},
+    {"id": "eng", "name": "英语"},
+    {"id": "jpn", "name": "日语"},
+    {"id": "chi_sim_vert", "name": "简体中文（竖排）"},
+    {"id": "chi_tra_vert", "name": "繁体中文（竖排）"},
+]
+
+
+def fetch(model_id, path):
+    last = None
+    for tpl in SOURCES:
+        url = tpl.format(id=model_id)
+        try:
+            req = urllib.request.Request(url, headers={"User-Agent": "moon-ocr-builder/1.0"})
+            with urllib.request.urlopen(req, timeout=120) as res, open(path + ".tmp", "wb") as out:
+                while True:
+                    chunk = res.read(256 * 1024)
+                    if not chunk:
+                        break
+                    out.write(chunk)
+            os.replace(path + ".tmp", path)
+            return
+        except Exception as err:  # 换下一个源
+            last = err
+    raise SystemExit("download failed: %s (%s)" % (model_id, last))
+
+
+def digest(path):
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for chunk in iter(lambda: f.read(256 * 1024), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--fetch", action="store_true")
+    parser.add_argument("--out-dir", default="assets/ocr")
+    args = parser.parse_args()
+    os.makedirs(args.out_dir, exist_ok=True)
+    models = []
+    for model in MODELS:
+        path = os.path.join(args.out_dir, model["id"] + ".traineddata")
+        if args.fetch or not os.path.exists(path):
+            fetch(model["id"], path)
+        models.append({
+            "id": model["id"],
+            "name": model["name"],
+            "file": model["id"] + ".traineddata",
+            "size": os.path.getsize(path),
+            "sha256": digest(path),
+        })
+    manifest = {
+        "version": 1,
+        "variant": "tessdata_fast",
+        "source": "https://github.com/tesseract-ocr/tessdata_fast",
+        "license": "Apache-2.0",
+        "models": models,
+    }
+    with open(os.path.join(args.out_dir, "manifest.json"), "w", encoding="utf-8") as f:
+        json.dump(manifest, f, ensure_ascii=False, indent=2)
+        f.write("\n")
+    print("wrote %d models" % len(models))
+
+
+if __name__ == "__main__":
+    main()
