{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "LuaJIT",
    "path": [
      "book.koplugin/?.lua",
      "book.koplugin/?/init.lua",
      "koreader/frontend/?.lua",
      "koreader/frontend/?/init.lua",
      "koreader/base/?.lua",
      "koreader/base/?/init.lua"
    ]
  },
  "workspace": {
    "library": [
      "koreader/frontend",
      "koreader/base",
      "book.koplugin/types"
    ],
    "useGitIgnore": true,
    "ignoreDir": [
      ".git",
      "screenshots",
      "koreader",
      "book.koplugin/source/qidian/fock_wasm.lua"
    ],
    "checkThirdParty": "Disable"
  },
  "type": {
    "weakNilCheck": true
  },
  "diagnostics": {
    "globals": [
      "G_reader_settings",
      "G_defaults"
    ],
    "disable": [
      "lowercase-global",
      "duplicate-set-field",
      "need-check-nil"
    ]
  },
  "completion": {
    "callSnippet": "Replace"
  }
}
